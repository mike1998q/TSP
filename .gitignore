# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Data & artifacts
data/*.csv
checkpoints/*.pt
checkpoints/*.json
*.png
!docs/**/*.png

# Notebooks / IDE
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store

# PyTorch / CUDA caches
*.pth
.torch_compile_cache/

# Raw datasets (downloaded, not versioned)
data/*.csv
data/*.txt
data/*.gz

# LaTeX build artifacts (main.pdf is intentionally tracked)
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.log
paper/**/*.spl
paper/**/*.out
paper/**/*.toc

# Stray LaTeX artifacts from a run outside paper/ (e.g. wrong cwd)
texput.log
*.synctex.gz
